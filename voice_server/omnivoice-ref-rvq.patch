+// .rvq files are a flat 11-bit LSB-first stream, [K, T] row-major, no header.
+// The pinned runtime has 8 codebooks; omnivoice-codec wrote this file.
+static const int RVQ_CODE_BITS = 11;
+static const int RVQ_CODE_MASK = (1 << RVQ_CODE_BITS) - 1;
+
+static bool read_rvq_file(const char * path, int K, std::vector<int32_t> & codes, int * n_frames) {
+    FILE * f = fopen(path, "rb");
+    if (!f) {
+        fprintf(stderr, "[RVQ] FATAL: cannot open %s\n", path);
+        return false;
+    }
+    fseek(f, 0, SEEK_END);
+    long size = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (size <= 0) {
+        fprintf(stderr, "[RVQ] FATAL: %s is empty\n", path);
+        fclose(f);
+        return false;
+    }
+    std::vector<uint8_t> buf((size_t) size);
+    if (fread(buf.data(), 1, buf.size(), f) != buf.size()) {
+        fprintf(stderr, "[RVQ] FATAL: short read on %s\n", path);
+        fclose(f);
+        return false;
+    }
+    fclose(f);
+
+    const size_t n_codes = (buf.size() * 8) / (size_t) RVQ_CODE_BITS;
+    if (n_codes == 0 || (n_codes % (size_t) K) != 0) {
+        fprintf(stderr, "[RVQ] FATAL: %s yields %zu codes, not a multiple of K=%d\n", path, n_codes, K);
+        return false;
+    }
+    codes.resize(n_codes);
+    uint64_t acc      = 0;
+    int      in_bits  = 0;
+    size_t   in_pos   = 0;
+    for (size_t i = 0; i < n_codes; i++) {
+        while (in_bits < RVQ_CODE_BITS && in_pos < buf.size()) {
+            acc |= ((uint64_t) buf[in_pos++]) << in_bits;
+            in_bits += 8;
+        }
+        codes[i] = (int32_t) (acc & (uint64_t) RVQ_CODE_MASK);
+        acc >>= RVQ_CODE_BITS;
+        in_bits -= RVQ_CODE_BITS;
+    }
+    *n_frames = (int) (n_codes / (size_t) K);
+    return true;
+}
