# ==========================================================================
# AI Dungeon Local — variáveis de ambiente
#
# Copie para .env e preencha:   copy .env.example .env   (Windows)
# O .env real é gitignored e NUNCA deve ser commitado.
# ==========================================================================

# Chave da API do servidor LLM (llama.cpp na VM — http://vm.groupabz.com:1234/v1).
# Combinada com quem opera a VM. Também pode ser ajustada depois na UI (aba Config)
# ou via PUT /api/settings/llm — o valor do banco tem precedência sobre este.
LLM_API_KEY=

# Usuário da página de login da UI.
AUTH_USER=Caio

# sha256 hex da senha do login (NUNCA a senha em texto claro). Gerar com:
#   python -c "import hashlib; print(hashlib.sha256('SUA_SENHA'.encode('utf-8')).hexdigest())"
AUTH_PASSWORD_HASH=<sha256-hex-da-senha>

# Segredo HMAC que assina os tokens de sessão (qualquer hex aleatório de 32 bytes).
# Gerar com:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=<gere-com-python-secrets.token_hex(32)>
