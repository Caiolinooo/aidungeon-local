[Unit]
Description=Watchdog de slots do llama-server (llama.cpp #28280)
After=llama-server.service

[Service]
Type=oneshot
# Root: reinicia o llama-server. O script fica fora da home (root:root 755).
ExecStart=/usr/bin/python3 /usr/local/sbin/slot_watchdog.py --env-file /home/caio/aidungeon/.env --state-dir /var/lib/slot-watchdog --hint-file /home/caio/aidungeon/data/llm_stall_hint.json --hint-file /home/caio/aidungeon-staging/data/llm_stall_hint.json
StateDirectory=slot-watchdog
StateDirectoryMode=0755
# Roda a cada 10 s: sem isso o PID 1 loga Starting/Finished em toda rodada.
# Reinício e espera saem com prioridade warning/notice (prefixo <n> do script).
LogLevelMax=notice
